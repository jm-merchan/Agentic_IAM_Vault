{
  "type": "object",
  "required": ["type", "path", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "type": {"const": "vault:path_access"},
    "path": {"type": "string", "pattern": "^[A-Za-z0-9._/:-]+$"},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["read", "create", "update", "delete", "sudo", "list", "deny"]}}
  }
}
