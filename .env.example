# Bash syntax. Copy to .env; keep credentials out of notebooks and console output.
# External inputs only: do NOT add VAULT_TOKEN, VAULT_ADDR or VAULT_CACERT.
# demo.sh initializes/unseals Vault before writing its private bootstrap to
# ~/.local/state/lumen-vault-demo/vault/{cluster-keys.json,config.env}.
VERIFY_TENANT='https://<tu-tenant>.verify.ibm.com'
VERIFY_ADMIN_CLIENT_ID=''
VERIFY_ADMIN_CLIENT_SECRET=''
XAI_MANAGEMENT_API_KEY=''
XAI_TEAM_ID=''
# Select automatically by management key: OpenAI wins if both are present.
# Override with LUMEN_MODEL_PROVIDER=xai/openai or ./demo.sh start --provider xai.
LUMEN_MODEL_PROVIDER=auto
OPENAI_ADMIN_API_KEY=''
OPENAI_PROJECT_ID=''
OPENAI_SERVICE_ACCOUNT_ID=''
OPENAI_IDENTITY_PROVIDER_ID=''
LUMEN_OPENAI_MODEL=gpt-4.1-mini
NGROK_DOMAIN=nondemanding-indistinguishably-claude.ngrok-free.dev
# Optional if ngrok is already authenticated locally. Use your own domain on another account.
NGROK_AUTHTOKEN=''
SPIFFE_TRUST_DOMAIN=lumen.demo
TAVILY_API_KEY=''
ORACLE_REG_EMAIL=''
ORACLE_REG_PASSWORD=''
VAULT_LICENSE=''
MYSQL_ROOT_PASSWORD=''
LUMEN_READER_PASSWORD=''
LUMEN_WRITER_PASSWORD=''
LUMEN_SUPERVISOR_PASSWORD=''

# This demo uses context workshop and namespaces vault, mysql, verify,
# lumen-observability. Ports are bound to localhost.
MINIKUBE_DRIVER=podman
CONTAINER_ENGINE=podman
MINIKUBE_MEMORY=8192
MINIKUBE_CPUS=4
VAULT_IMAGE_REPOSITORY=josemerchan/vault-xai
VAULT_IMAGE_TAG=2.1.2-ent
VAULT_HELM_VERSION=0.34.1
LUMEN_XAI_MODEL=grok-4.3
LUMEN_VAULT_AUDIT_MODE=raw
LUMEN_TRACE_VAULT_RAW=1
LUMEN_TRACE_CONTENT=1
